; Probe tool length using RapidChange tool setter
; Must be called form something that manages dust cover opening/closing
o<_rapidchange_probe> sub
    ; Don't execute in UI preview
    O100 if [#<_task> EQ 0]
        (print, Skipping in preview)
    O100     return [999]
    O100 endif

    (print, Probing tool length)

    M70 ; Save modal states
    G21 ; Millimeters
    G49 ; Clear existing tool length

    G90 ; Move to pocket position in absolute
    G53 G0 Z[#<_ini[RAPIDCHANGEATC]SAFE_Z>] ; Move to safe Z

    ; Move to tool setter XY
    G53 G0 X[#<_ini[RAPIDCHANGEATC]TOOLSET_X>] Y[#<_ini[RAPIDCHANGEATC]TOOLSET_Y>]

    G91 ; Probes have to be done in incremental mode

    ; Probe down using a fast feedrate
    G38.2 Z[#<_ini[RAPIDCHANGEATC]TOOLSET_SEARCH_DISTANCE>] F[#<_ini[RAPIDCHANGEATC]TOOLSET_SEARCH_FEED>]

    ; Move up before latch probe
    G0 Z[#<_ini[RAPIDCHANGEATC]TOOLSET_LATCH_BACKOFF>] 
    ; Allow a half second for the probe input to clear
    G4 P0.5
    ; Probe at latch speed/distance for more accurate reading
    G38.2 Z[#<_ini[RAPIDCHANGEATC]TOOLSET_LATCH_DISTANCE>] F[#<_ini[RAPIDCHANGEATC]TOOLSET_LATCH_FEED>]

    G90 ; Set absolute coordinates
    G53 G0 Z[#<_ini[RAPIDCHANGEATC]SAFE_Z>] ; Move to safe Z

    ; Calculate tool length

    ; Position probe triggered
    #<probe_triggered_z> = #5063
    ; Find Z offset of current WCS (#5220), for example #5223 stores WCS1 Z offset
    #<wcs_z> = [#[5203 + #5220 * 20]]
    ; Combined G92 and G52 offsets(#5213) if enabled (#5210 = 1)
    #<coordinate_offset_z> = [#5213 * #5210]
    #<tool_length> = [#<probe_triggered_z> - #<_ini[RAPIDCHANGEATC]TOOLSET_HEIGHT> + #<wcs_z>]
    
    (print, Saving tool length)
    (print, _current_tool=#<_current_tool>)
    (print, probe_triggered_z=#<probe_triggered_z>)
    (print, coordinate_offset_z=#<coordinate_offset_z>)
    (print, wcs_z=#<wcs_z>)
    (print, [RAPIDCHANGEATC]TOOLSET_HEIGHT=#<_ini[RAPIDCHANGEATC]TOOLSET_HEIGHT>)
    (print, tool_length=#<tool_length>)
    
    G10 L1 P#<_current_tool> Z#<tool_length> 

    M72 ; Restore modal state before G43 or it won't apply after returning

    G43 ; Enable tool length compenstation
o<_rapidchange_probe> endsub [1]

M2

