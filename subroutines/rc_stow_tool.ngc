; This file is a blend of PathPilot tool_change.ngc and Haskins Guitars rapidchange_m6.ngc.  It is intended to be used with the RapidChange remap for PathPilot.  
; The original code is copyright 2020-2023 by Haskins Guitars, LLC  (no known license)
; and tormach_tool_change is copyright Tormach, licensed under the GPL2.
o<rc_stow_tool> sub
    (Prevent limit errors due to axis compensation by retracting just below the Z limit)
    #<rack_z_clear> = -0.01
    (PRINT,rc_stow_tool entered, storing tool [#<_old_tool>])
    (queue buster)
    (M66 P63 L0)

    ; TODO Might try to use this later (let rack_tool_changer.py know what tool we're stowing.  Used to update GUI rack display)
    #<this_tool> = #<_old_tool>
    ;M68 E[#<_rack_aout_old_tool>] Q[#<this_tool>]
    ;M68 E[#<_rack_aout_complete>] Q0 */

    G53 G0 Z[#<rack_z_clear>]

    M5  (ensure spindle is stopped before attempting to stow tool)
    G90 ; Absolute programming mode
    G61 ; Exact Stop mode (to avoid overshoot of tool holder)   

    
    o<manage_cover> if [#<_ini[RAPIDCHANGEATC]COVER_DO> ge 0]
        ; Open dust cover
        M64 P[#<_rc_cover_DO>] (open dust cover)
    o<manage_cover> endif

    ; move to safe Z
    G53 G0 Z[#<_rc_safe_Z>]
    (bust queue to insure move complete before moving into tool holder)
    M66 P63 L0

    (Ready to do the tool drop/stow)

    (print, Dropping tool #<_old_tool> at #<_rc_drop_x>,#<rc_drop_y>)
    ; move to rc_drop_x, rc_drop_y
    G53 G0 X[#<_rc_drop_x>] Y[#<_rc_drop_y>]

    ; Move close to pocket
    (PRINT, Moving to engage Z start: [#<_rc_engage_Z_start>])
    G53 G0 Z[#<_rc_engage_Z_start>]
    M66 P63 L0

    ; Spindle on
    M4 S[#<_rc_engage_unload_rpm>]

    #<strikes_remaining> = #<_rc_engage_unload_strikes>
    o131 while [#<strikes_remaining> gt 0]
        #<strikes_remaining> = [#<strikes_remaining> - 1]

        ; Lower into pocket
        G53 G1 Z[#<_rc_engage_Z_end>] F[#<_rc_engage_feed>] 

        ; Move to IR checking position
        G53 G1 Z[#<_rc_engage_Z_start>] F[#<_rc_engage_feed>]
        M66 P63 L0
    o131 endwhile
    
    M5 ; Stop spindle
    G4 P1  ; Dwell to allow spindle to stop

    o132 if [#<_rc_IR_DI> lt 0]
        (print, Unload Success. No IR DI configured, assuming success.)
    o132 else
        M66 P[#<_rc_IR_DI>] L0  ; Read IR sensor status

        o133 if [#5399 ne 0]
            (msg, Unload FAILED! Tool still present)
            G53 G0 Z[#<_rc_safe_Z>]
        o133 return [-2] ; Fail M6
        o133 endif
    o132 endif

    G49 ; clear current tool offset

    G53 G0 Z[#<_rc_safe_Z>]
    
    (spindle officially empty. Doing this after Z up, with the idea a power fail before the Z up will mean the tool will be left in spindle still, which is true.)
    (This is far from atomic, so there remains a window of "in-opportunity" where PP and Linuxcnc could get out of sync WRT where tool is)
    (TODO ? M68 E[#<_rack_aout_complete>] Q[.3 + #<this_tool>] (signal stow success with tool + (RAR_STOW_SUCCESS/10)))
    M61 Q0

o<rc_stow_tool> endsub [0]

