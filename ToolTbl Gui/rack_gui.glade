<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.0"/>
  <object class="GtkListStore" id="pocket_store">
    <columns>
      <column type="gint"/>
      <column type="gint"/>
      <column type="gchararray"/>
    </columns>
  </object>
  <object class="GtkWindow" id="main_window">
    <property name="title">RapidChange ATC Pocket Map</property>
    <property name="default_width">500</property>
    <property name="default_height">450</property>
    <property name="border_width">12</property>
    <signal name="destroy" handler="on_main_window_destroy"/>
    <child>
      <object class="GtkBox" id="main_box">
        <property name="visible">True</property>
        <property name="can_focus">False</property>
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <child>
          <object class="GtkLabel" id="instructions_label">
            <property name="visible">True</property>
            <property name="xalign">0</property>
            <property name="label">This editor manages the separate RapidChange pocket map only.  Select a row to remove its tool; enter a tool number and choose an empty pocket to assign or move it.</property>
            <property name="wrap">True</property>
          </object>
          <packing><property name="expand">False</property><property name="fill">True</property></packing>
        </child>
        <child>
          <object class="GtkScrolledWindow" id="scrolled_window">
            <property name="visible">True</property>
            <property name="shadow_type">in</property>
            <child>
              <object class="GtkTreeView" id="pocket_tree">
                <property name="visible">True</property>
                <property name="model">pocket_store</property>
                <property name="headers_visible">True</property>
                <signal name="cursor-changed" handler="on_pocket_tree_cursor_changed"/>
                <child>
                  <object class="GtkTreeViewColumn" id="pocket_column">
                    <property name="title">Pocket</property>
                    <child><object class="GtkCellRendererText" id="pocket_renderer"/><attributes><attribute name="text">0</attribute></attributes></child>
                  </object>
                </child>
                <child>
                  <object class="GtkTreeViewColumn" id="tool_column">
                    <property name="title">Tool</property>
                    <child><object class="GtkCellRendererText" id="tool_renderer"/><attributes><attribute name="text">2</attribute></attributes></child>
                  </object>
                </child>
              </object>
            </child>
          </object>
          <packing><property name="expand">True</property><property name="fill">True</property></packing>
        </child>
        <child>
          <object class="GtkGrid" id="input_grid">
            <property name="visible">True</property>
            <property name="column_spacing">10</property>
            <property name="row_spacing">6</property>
            <child>
              <object class="GtkLabel" id="tool_label"><property name="visible">True</property><property name="label">Tool number</property><property name="xalign">0</property></object>
              <packing><property name="left_attach">0</property><property name="top_attach">0</property></packing>
            </child>
            <child>
              <object class="GtkEntry" id="tool_entry"><property name="visible">True</property><property name="input_purpose">digits</property></object>
              <packing><property name="left_attach">1</property><property name="top_attach">0</property></packing>
            </child>
            <child>
              <object class="GtkLabel" id="destination_label"><property name="visible">True</property><property name="label">Empty destination</property><property name="xalign">0</property></object>
              <packing><property name="left_attach">0</property><property name="top_attach">1</property></packing>
            </child>
            <child>
              <object class="GtkComboBoxText" id="pocket_combo"><property name="visible">True</property></object>
              <packing><property name="left_attach">1</property><property name="top_attach">1</property></packing>
            </child>
          </object>
          <packing><property name="expand">False</property><property name="fill">True</property></packing>
        </child>
        <child>
          <object class="GtkButtonBox" id="button_box">
            <property name="visible">True</property>
            <property name="layout_style">end</property>
            <child><object class="GtkButton" id="assign_btn"><property name="visible">True</property><property name="label">Assign Tool</property><signal name="clicked" handler="on_assign_btn_clicked"/></object></child>
            <child><object class="GtkButton" id="remap_btn"><property name="visible">True</property><property name="label">Move Tool</property><signal name="clicked" handler="on_remap_btn_clicked"/></object></child>
            <child><object class="GtkButton" id="remove_btn"><property name="visible">True</property><property name="label">Empty Selected Pocket</property><signal name="clicked" handler="on_remove_btn_clicked"/></object></child>
            <child><object class="GtkButton" id="close_btn"><property name="visible">True</property><property name="label">Close</property><signal name="clicked" handler="on_close_btn_clicked"/></object></child>
          </object>
          <packing><property name="expand">False</property><property name="fill">True</property></packing>
        </child>
        <child>
          <object class="GtkLabel" id="status_label"><property name="visible">True</property><property name="xalign">0</property><property name="ellipsize">end</property></object>
          <packing><property name="expand">False</property><property name="fill">True</property></packing>
        </child>
      </object>
    </child>
  </object>
</interface>
